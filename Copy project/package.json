{
  "name": "vedashield-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "anatomy": "node scripts/download-anatomy.mjs",
    "worker:dev": "wrangler dev",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@google/genai": "2.24.0",
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.4.0",
    "@supabase/supabase-js": "2.117.1",
    "bcryptjs": "3.0.2",
    "cookie-parser": "1.4.7",
    "express": "5.1.0",
    "express-rate-limit": "8.7.0",
    "helmet": "8.1.0",
    "lucide-react": "0.468.0",
    "multer": "2.4.0",
    "pdfjs-dist": "5.4.624",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "3.3.0",
    "tesseract.js": "6.0.1",
    "three": "0.180.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "9.2.0",
    "supabase": "^2.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "vite": "7.3.6",
    "wrangler": "^4.144.0"
  }
}