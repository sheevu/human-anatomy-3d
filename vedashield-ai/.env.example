# VedaShield AI - Environment Configuration

# 1. Google Gemini API (Multimodal OCR & Bilingual Health Insights)
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

# 2. Supabase Configuration (Optional - Offline LocalStorage fallback active by default)
# Get credentials from your Supabase project: https://supabase.com/
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 3. Server Configuration
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
